#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 diskOS contributors
# /opt/diskos/bin/bluealsa: Interceptor wrapper for BlueALSA on diskOS.
# Resolves ahead of /usr/bin/bluealsa via PATH=/opt/diskos/bin:$PATH.
#
# Capabilities:
# 1. Low Latency Mode for Bluetooth Receiving (a2dp-sink):
#    When enabled in Settings (bt_rx_ll=1), disables high-latency codecs
#    (AAC, LDAC, aptX, aptX-HD) and enforces SBC only, minimizing latency.
# 2. aptX / aptX-HD support:
#    When bluealsa-custom is available, enables aptX and aptX-HD codecs.
# 3. Full Duplex Profile Support:
#    Ensures both a2dp-source and a2dp-sink profiles are available so the Disc
#    can both transmit to BT headphones and receive from phones/computers.
# 4. Fail-closed fallback:
#    If bluealsa-custom is unavailable, transparently delegates to stock /usr/bin/bluealsa.

set -e

# Target selection: prioritize custom aptX-enabled binary (deployed or flashed)
if [ -x "/usr/data/bin/bluealsa-custom" ]; then
    TARGET="/usr/data/bin/bluealsa-custom"
elif [ -x "/usr/data/bluealsa-custom" ]; then
    TARGET="/usr/data/bluealsa-custom"
elif [ -x "/opt/diskos/bin/bluealsa-custom" ]; then
    TARGET="/opt/diskos/bin/bluealsa-custom"
elif [ -x "/usr/bin/bluealsa" ]; then
    TARGET="/usr/bin/bluealsa"
else
    echo "bluealsa: no executable found" >&2
    exit 127
fi

IS_CUSTOM=0
case "$TARGET" in
    *bluealsa-custom*) IS_CUSTOM=1 ;;
esac

# Check if Low Latency mode is enabled
LL_ENABLED=0
if [ -f /usr/data/bt_rx_ll ]; then
    if [ "$(cat /usr/data/bt_rx_ll 2>/dev/null)" = "1" ]; then
        LL_ENABLED=1
    fi
elif [ -f /usr/data/diskos.conf ]; then
    if grep -q '^bt_rx_ll=1' /usr/data/diskos.conf 2>/dev/null; then
        LL_ENABLED=1
    fi
fi

# Check if a specific receiver codec preference is configured
RX_CODEC=""
if [ -f /usr/data/bt_rx_codec ]; then
    RX_CODEC="$(cat /usr/data/bt_rx_codec 2>/dev/null | tr -d '\r\n ')"
fi

# Detect requested profiles before rewriting positional arguments
HAS_SOURCE=0
HAS_SINK=0
for arg in "$@"; do
    case "$arg" in
        *a2dp-source*) HAS_SOURCE=1 ;;
        *a2dp-sink*)   HAS_SINK=1 ;;
    esac
done

# Filter existing codec arguments via positional parameters (no unquoted word-splitting)
orig_count=$#
SKIP_NEXT=0
while [ "$orig_count" -gt 0 ]; do
    arg=$1
    shift
    orig_count=$((orig_count - 1))
    if [ "$SKIP_NEXT" -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        --codec=*)
            ;;
        -c|--codec)
            SKIP_NEXT=1
            ;;
        *)
            set -- "$@" "$arg"
            ;;
    esac
done

if [ "$HAS_SOURCE" -eq 0 ] && [ "$HAS_SINK" -eq 0 ]; then
    set -- "$@" "--profile=a2dp-source"
fi
if [ "$HAS_SINK" -eq 0 ]; then
    set -- "$@" "--profile=a2dp-sink"
fi

if [ "$LL_ENABLED" -eq 1 ] && [ "$HAS_SOURCE" -eq 0 ]; then
    # LOW LATENCY MODE (BT Receiving only):
    # Disable high-latency / buffered codecs (AAC, aptX, aptX-HD, LDAC) so Android/iOS/PC
    # negotiates SBC only, keeping audio latency low (~80-120ms).
    exec "$TARGET" "$@" --codec=sbc --codec=-aac --codec=-aptX --codec=-aptX-HD --codec=-ldac
elif [ "$HAS_SOURCE" -eq 0 ] && [ -n "$RX_CODEC" ] && [ "$RX_CODEC" != "AUTO" ] && [ "$RX_CODEC" != "Auto" ]; then
    # PREFERRED RECEIVER CODEC MODE (sink-only invocation):
    case "$RX_CODEC" in
        SBC|sbc)
            exec "$TARGET" "$@" --codec=sbc --codec=-aac --codec=-aptX --codec=-aptX-HD --codec=-ldac
            ;;
        AAC|aac)
            exec "$TARGET" "$@" --codec=aac --codec=sbc --codec=-aptX --codec=-aptX-HD --codec=-ldac
            ;;
        LDAC|ldac)
            exec "$TARGET" "$@" --codec=ldac --codec=sbc --codec=-aac --codec=-aptX --codec=-aptX-HD
            ;;
        aptX|aptx)
            if [ "$IS_CUSTOM" -eq 1 ]; then
                exec "$TARGET" "$@" --codec=aptX --codec=sbc --codec=-aac --codec=-aptX-HD --codec=-ldac
            else
                exec "$TARGET" "$@" --codec=sbc --codec=aac --codec=ldac
            fi
            ;;
        aptX-HD|aptx-hd|aptXHD)
            if [ "$IS_CUSTOM" -eq 1 ]; then
                exec "$TARGET" "$@" --codec=aptX-HD --codec=sbc --codec=-aac --codec=-aptX --codec=-ldac
            else
                exec "$TARGET" "$@" --codec=sbc --codec=aac --codec=ldac
            fi
            ;;
        *)
            if [ "$IS_CUSTOM" -eq 1 ]; then
                exec "$TARGET" "$@" --codec=sbc --codec=aac --codec=aptX --codec=aptX-HD --codec=ldac
            else
                exec "$TARGET" "$@" --codec=sbc --codec=aac --codec=ldac
            fi
            ;;
    esac
else
    # STANDARD MODE: enable all supported codecs
    if [ "$IS_CUSTOM" -eq 1 ]; then
        exec "$TARGET" "$@" --codec=sbc --codec=aac --codec=aptX --codec=aptX-HD --codec=ldac
    else
        exec "$TARGET" "$@" --codec=sbc --codec=aac --codec=ldac
    fi
fi
